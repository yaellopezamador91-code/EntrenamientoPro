        android:supportsRtl="true"
        android:theme="@style/Theme.EntrenamientoPro"
        tools:targetApi="31">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7645686135936049~6304167705"/>
